---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

const homeDescription =
  'Platform engineering that works in production. Practical DevOps and platform engineering for AWS, GCP, Kubernetes, and IaC. Simplify cloud operations, reduce waste, and build systems your team can actually own. No corporate speak.'

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'OpsDevCode',
  description: homeDescription,
  url: 'https://opsdevco.de',
  email: 'eric@opsdevco.de',
  areaServed: 'Worldwide',
  serviceType: ['Platform Engineering', 'Cloud Infrastructure', 'FinOps', 'AWS', 'GCP', 'DevOps', 'Kubernetes', 'IaC'],
}
---

<BaseLayout
  title="OpsDevCode | Platform Engineering Advisory"
  description={homeDescription}
  structuredData={structuredData}
>
  <Header />
  <main id="main">
    <div class="wrap">
      <section class="hero">
        <div class="hero-inner">
          <h1>Platform engineering<br /><span class="highlight">that actually works in production.</span></h1>
          <p class="sub">
            Practical DevOps and platform engineering for AWS, GCP, Kubernetes, and IaC. Simplify cloud operations, reduce waste, and build systems your team can actually own.
          </p>
          <div class="cta">
            <a class="btn primary" href="https://calendly.com/eric-opsdevco/30min" target="_blank" rel="noopener noreferrer">Book a discovery call</a>
            <a class="btn" href="/about#contact">Email me directly</a>
          </div>
          <p class="hero-reassure">
            No pressure — just a quick conversation to see if it makes sense.
          </p>
          <p class="hero-cred">
            Built by a platform engineer with hands-on experience across multiple clouds, Kubernetes, IaC, and delivery systems.
          </p>
        </div>
      </section>

      <section class="section audience" aria-labelledby="who-for-heading">
        <h2 id="who-for-heading" class="section-title">Who this is for</h2>
        <div class="grid grid-2col">
          <div class="tile">
            <p>
              Teams with <strong>AWS, GCP, or Kubernetes</strong> setups that have become harder to manage than they should be.
            </p>
          </div>
          <div class="tile">
            <p>
              <strong>Engineering leaders</strong> who need hands-on platform help without hiring a large consulting firm.
            </p>
          </div>
          <div class="tile">
            <p>
              Teams dealing with <strong>slow delivery</strong>, unclear infrastructure, or rising cloud costs.
            </p>
          </div>
        </div>
      </section>

      <section class="section how-work" aria-labelledby="how-work-heading">
        <h2 id="how-work-heading" class="section-title">How I work</h2>
        <div class="grid grid-2col">
          <div class="tile">
            <p>
              <strong>Time-boxed engagements</strong> with clear outcomes.
            </p>
          </div>
          <div class="tile">
            <p>
              <strong>Practical platform engineering</strong>, not slide decks. Real depth on AWS, GCP, Kubernetes, and IaC — no corporate speak, no bloated consulting.
            </p>
          </div>
          <div class="tile">
            <p>
              I can advise, pair with your team, or build.
            </p>
          </div>
          <div class="tile">
            <p>
              Focused on <strong>systems your team can own</strong> after I leave.
            </p>
          </div>
        </div>
      </section>

      <section class="section">
        <h2 class="section-title">Services</h2>
        <ul class="service-list">
          <li>
            <a href="/services#platform-health">Platform Health Check</a>
            <p>Identify bottlenecks, risks, and unnecessary complexity in your platform, with clear next steps to improve it.</p>
          </li>
          <li>
            <a href="/services/finops">FinOps</a>
            <p>Reduce cloud spend and improve visibility into where your infrastructure budget is going.</p>
          </li>
          <li>
            <a href="/services/iac">IaC</a>
            <p>Clean up and standardize your infrastructure as code so your team can move faster with less risk.</p>
          </li>
          <li>
            <a href="/services/cicd">CI/CD</a>
            <p>Speed up delivery with simpler, more reliable pipelines that your team can actually maintain.</p>
          </li>
          <li>
            <a href="/services/custom-tooling">Custom tooling</a>
            <p>Build lightweight internal tools to remove friction and automate repetitive work.</p>
          </li>
          <li>
            <a href="/agentic">Agentic Development</a>
            <p>Explore and implement agent-based workflows to improve development and operational efficiency.</p>
          </li>
        </ul>
        <p style="margin-top: var(--space-24);">
          <a class="btn" href="/services">All services</a>
        </p>
      </section>

      <section class="section trust" aria-label="About the practice">
        <div class="testimonial">
          <p class="note" style="margin: 0">
            OpsDevCode is built for teams that need practical platform help from someone who has actually operated these systems. I work hands-on across AWS, GCP, Kubernetes, IaC, delivery pipelines, and lightweight internal tooling — clarity, ownership, and real outcomes, not slide-deck consulting.
          </p>
        </div>
        <p class="fine" style="margin-top: var(--space-16); margin-bottom: 0">
          <a href="/about">About</a> — who runs this practice and how to reach me.
        </p>
      </section>

      <Footer />
    </div>
  </main>
</BaseLayout>
