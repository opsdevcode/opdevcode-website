---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

const homeDescription =
  'Platform engineering that works in production. Practical DevOps and platform engineering for AWS, GCP, Kubernetes, and IaC. Simplify cloud operations, reduce waste, and build systems your team can actually own. No corporate speak.'

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'OpsDevCode',
  description: homeDescription,
  url: 'https://opsdevco.de',
  email: 'eric@opsdevco.de',
  areaServed: 'Worldwide',
  serviceType: ['Platform Engineering', 'Cloud Infrastructure', 'FinOps', 'AWS', 'GCP', 'DevOps', 'Kubernetes', 'IaC'],
}
---

<BaseLayout
  title="OpsDevCode | Platform Engineering Advisory"
  description={homeDescription}
  structuredData={structuredData}
>
  <Header />
  <main id="main">
    <div class="wrap home">
      <section class="hero">
        <div class="hero-inner">
          <h1>Platform engineering<br /><span class="highlight">that actually works in production.</span></h1>
          <p class="sub">
            Practical DevOps and platform engineering for AWS, GCP, Kubernetes, and IaC.
          </p>
          <p class="hero-fit">
            If your platform is harder to manage than it should be, this is for you.
          </p>
          <ul class="hero-sub-points scan-list">
            <li>Simplify cloud operations and reduce waste</li>
            <li>Build systems your team can actually own</li>
          </ul>
          <p class="hero-anti-consulting">
            This isn’t traditional consulting — no large teams, no bloated engagements, no unnecessary layers.
            Just focused, hands-on work that improves your systems.
          </p>
          <div class="cta">
            <a class="btn primary" href="https://calendly.com/eric-opsdevco/30min" target="_blank" rel="noopener noreferrer">Book a discovery call</a>
            <a class="btn" href="/about#contact">Email me directly</a>
          </div>
          <p class="hero-reassure">
            No pressure — just a quick conversation to see if it makes sense.
          </p>
          <p class="hero-cred">Built by a platform engineer.</p>
          <p class="hero-cred">
            Hands-on experience across multiple clouds, Kubernetes, IaC, and delivery systems.
          </p>
        </div>
      </section>

      <section
        class="section primary-problem home-flow home-flow--clarity"
        aria-labelledby="primary-problem-heading"
      >
        <h2 id="primary-problem-heading" class="section-title">
          Most teams don’t have a DevOps problem — they have a complexity problem.
        </h2>
        <div class="primary-problem-body">
          <p>
            Too many tools, unclear infrastructure, rising cloud costs, and delivery friction. Platform
            engineering should reduce that complexity, not add more layers.
          </p>
        </div>
      </section>

      <section
        class="section before-after home-flow home-flow--clarity"
        aria-labelledby="before-after-heading"
      >
        <h2 id="before-after-heading" class="section-title">Before / After</h2>
        <div class="split before-after-split">
          <div class="before-after-panel is-before">
            <h3 class="before-after-label">Before</h3>
            <ul class="before-after-list scan-list">
              <li>Messy infrastructure and unclear ownership</li>
              <li>Slow or fragile CI/CD pipelines</li>
              <li>Rising cloud costs with poor visibility</li>
            </ul>
          </div>
          <div class="before-after-panel is-after">
            <h3 class="before-after-label">After</h3>
            <ul class="before-after-list scan-list">
              <li>Clear, understandable systems your team can own</li>
              <li>Faster, more reliable delivery</li>
              <li>Better cost visibility and less operational friction</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="section audience" aria-labelledby="who-for-heading">
        <h2 id="who-for-heading" class="section-title">Who this is for</h2>
        <div class="grid grid-2col">
          <div class="tile">
            <p>
              Teams with <strong>AWS, GCP, or Kubernetes</strong> setups that have become harder to manage than they should be.
            </p>
          </div>
          <div class="tile">
            <p>
              <strong>Engineering leaders</strong> who need hands-on platform help without hiring a large consulting firm.
            </p>
          </div>
          <div class="tile">
            <p>
              Teams dealing with <strong>slow delivery</strong>, unclear infrastructure, or rising cloud costs.
            </p>
          </div>
        </div>
      </section>

      <section class="section how-work" aria-labelledby="how-work-heading">
        <h2 id="how-work-heading" class="section-title">How I work</h2>
        <div class="grid grid-2col">
          <div class="tile">
            <p>
              <strong>Time-boxed engagements</strong> with clear outcomes.
            </p>
          </div>
          <div class="tile">
            <p>
              <strong>Practical platform engineering</strong>, not slide decks.
            </p>
            <ul class="tile-inline-points scan-list">
              <li>Real depth on AWS, GCP, Kubernetes, and IaC</li>
              <li>No corporate speak, no bloated consulting</li>
            </ul>
          </div>
          <div class="tile">
            <p>
              I can advise, pair with your team, or build.
            </p>
          </div>
          <div class="tile">
            <p>
              Focused on <strong>systems your team can own</strong> after I leave.
            </p>
          </div>
        </div>
      </section>

      <section class="section services-section">
        <h2 class="section-title">Services</h2>
        <ul class="service-list">
          <li>
            <a href="/services#platform-health">Platform Health Check</a>
            <p>
              Identify bottlenecks, risks, and unnecessary complexity in your platform, with clear next steps to improve it.
            </p>
          </li>
          <li>
            <a href="/services/finops">FinOps</a>
            <p>Reduce cloud spend and improve visibility into where your infrastructure budget is going.</p>
          </li>
          <li>
            <a href="/services/iac">IaC</a>
            <p>Clean up and standardize infrastructure as code so your team can move faster with less risk.</p>
          </li>
          <li>
            <a href="/services/cicd">CI/CD</a>
            <p>Improve delivery speed and reliability with simpler pipelines your team can actually maintain.</p>
          </li>
          <li>
            <a href="/services/custom-tooling">Custom tooling</a>
            <p>Build lightweight internal tools that remove friction and automate repetitive work.</p>
          </li>
          <li>
            <a href="/agentic">Agentic Development</a>
            <p>Explore practical agent-based workflows that improve developer and operational efficiency.</p>
          </li>
        </ul>
        <p style="margin-top: var(--space-32);">
          <a class="btn" href="/services">All services</a>
        </p>
      </section>

      <section
        class="section example-outcomes home-flow home-flow--outcomes"
        aria-labelledby="example-outcomes-heading"
      >
        <h2 id="example-outcomes-heading" class="section-title">What this looks like in practice</h2>
        <ul class="example-outcomes-list scan-list">
          <li>Reduced cloud spend by identifying waste and misconfigured resources</li>
          <li>Simplified delivery pipelines to reduce deployment friction and failures</li>
          <li>Standardized IaC to improve clarity, ownership, and team velocity</li>
          <li>Built small internal tools to eliminate repetitive operational work</li>
        </ul>
      </section>

      <section class="section trust home-flow home-flow--trust" aria-labelledby="trust-heading">
        <h2 id="trust-heading" class="section-title">Hands-on practice</h2>
        <p class="trust-operator">
          Built by someone who has operated these systems — not just advised on them.
        </p>
        <div class="testimonial">
          <ul class="trust-points scan-list">
            <li>Built for teams that need practical platform help from someone who has actually operated these systems.</li>
            <li>Hands-on across AWS, GCP, Kubernetes, IaC, delivery pipelines, and lightweight internal tooling.</li>
            <li>Clarity, ownership, and real outcomes—not slide-deck consulting.</li>
          </ul>
        </div>
        <p class="fine" style="margin-top: var(--space-24); margin-bottom: 0">
          <a href="/about">About</a> — who runs this practice and how to reach me.
        </p>
      </section>

      <section
        class="section sounds-familiar home-flow home-flow--action"
        aria-labelledby="sounds-familiar-heading"
      >
        <h2 id="sounds-familiar-heading" class="section-title">If this sounds familiar</h2>
        <ul class="sounds-familiar-list scan-list">
          <li>Your infrastructure has grown messy over time</li>
          <li>Your pipelines feel slower or more fragile than they should</li>
          <li>Cloud costs keep rising without clear visibility</li>
          <li>Your team spends too much time managing systems instead of shipping</li>
        </ul>
        <p class="sounds-familiar-close">You’re exactly who this is for.</p>
      </section>

      <section
        class="section engagement-flow home-flow home-flow--action"
        aria-labelledby="how-it-works-heading"
      >
        <h2 id="how-it-works-heading" class="section-title">How it works</h2>
        <ol class="engagement-steps">
          <li class="engagement-step">
            <span class="engagement-step-index" aria-hidden="true">1</span>
            <div class="engagement-step-body">
              <p class="engagement-step-text">
                <strong>Discovery call</strong> — understand the current setup, problems, and priorities.
              </p>
            </div>
          </li>
          <li class="engagement-step">
            <span class="engagement-step-index" aria-hidden="true">2</span>
            <div class="engagement-step-body">
              <p class="engagement-step-text">
                <strong>Focused engagement</strong> — time-boxed work on the highest-impact areas.
              </p>
            </div>
          </li>
          <li class="engagement-step">
            <span class="engagement-step-index" aria-hidden="true">3</span>
            <div class="engagement-step-body">
              <p class="engagement-step-text">
                <strong>Practical outcomes</strong> — clear improvements your team can own after the engagement.
              </p>
            </div>
          </li>
        </ol>
        <ul class="engagement-follow scan-list" aria-label="How engagements are structured">
          <li>Time-boxed scopes with clear outcomes.</li>
          <li>From short assessments to focused implementation work.</li>
          <li>Meaningful improvements in weeks, not months.</li>
          <li>Not long-term dependency — systems your team understands and owns.</li>
        </ul>
      </section>

      <section
        class="section closing-cta home-flow home-flow--finale"
        aria-labelledby="closing-cta-heading"
      >
        <p class="closing-cta-kicker">Next step</p>
        <h2 id="closing-cta-heading" class="closing-cta-title">Start with a short discovery call</h2>
        <div class="cta">
          <a
            class="btn primary"
            href="https://calendly.com/eric-opsdevco/30min"
            target="_blank"
            rel="noopener noreferrer">Book a discovery call</a>
          <a class="btn" href="/about#contact">Email me directly</a>
        </div>
        <p class="hero-reassure closing-cta-reassure">
          Intro call to align on fit and scope—no obligation.
        </p>
      </section>

      <Footer />
    </div>
  </main>
</BaseLayout>
