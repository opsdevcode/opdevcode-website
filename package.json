{
  "name": "opdevcode-website",
  "version": "1.22.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "test": "A11Y_SKIP_BROWSER=1 node --test tests/*.test.mjs",
    "test:a11y": "node a11y/run.mjs",
    "test:a11y:force": "A11Y_FORCE_RUN=1 node a11y/run.mjs --force",
    "test:a11y:fixture": "node a11y/run.mjs --fixture-only",
    "test:a11y:detect": "node a11y/detect-ui-impact.mjs",
    "og:generate": "node scripts/screenshot-og.js",
    "netlify:login": "netlify login",
    "netlify:link": "netlify link",
    "netlify:deploy": "netlify deploy --prod",
    "netlify:status": "netlify status",
    "domain:godaddy": "scripts/godaddy-dns.sh",
    "domain:add": "scripts/setup-domain.sh",
    "domain:netlify": "scripts/add-netlify-domain.sh"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "next": "^15.5.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.3",
    "@types/node": "^22.19.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.10.3",
    "eslint": "^9.39.3",
    "eslint-config-next": "^15.5.12",
    "eslint-config-prettier": "^10.1.8",
    "netlify-cli": "^17.38.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3"
  }
}
